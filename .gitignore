# Unity .gitignore for a repo where the Unity project lives in the EscapeRoom2026/ subfolder.
# Place this file at the repo root (next to .git), NOT inside EscapeRoom2026.
#
# Rules starting with "/" are anchored to this file's location, so they are
# prefixed with /EscapeRoom2026/. Rules without a leading "/" match anywhere.
#
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

# macOS
.DS_Store

# Editors
.idea/
.vscode/

.utmp/
/EscapeRoom2026/[Ll]ibrary/
/EscapeRoom2026/[Tt]emp/
/EscapeRoom2026/[Oo]bj/
/EscapeRoom2026/[Bb]uild/
/EscapeRoom2026/[Bb]uilds/
/EscapeRoom2026/[Ll]ogs/
/EscapeRoom2026/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/EscapeRoom2026/[Mm]emoryCaptures/

# Recordings can get excessive in size
/EscapeRoom2026/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /EscapeRoom2026/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/EscapeRoom2026/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/EscapeRoom2026/ServerData
/EscapeRoom2026/[Aa]ssets/StreamingAssets/aa*
/EscapeRoom2026/[Aa]ssets/AddressableAssetsData/link.xml*
/EscapeRoom2026/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /EscapeRoom2026/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/EscapeRoom2026/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/EscapeRoom2026/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/EscapeRoom2026/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/EscapeRoom2026/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/EscapeRoom2026/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/EscapeRoom2026/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
/EscapeRoom2026/[Aa]ssets/[Ss]ceneDependencyCache*